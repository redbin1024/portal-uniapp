
.page.data-v-0b50ab4e {
  width: 100%;
  height: 100vh;
  position: relative;
  background: #000;
  will-change: transform;
}
.nav-bar.data-v-0b50ab4e {
  position: absolute;
  top: 100rpx;
  left: 0;
  right: 0;
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0));
  z-index: 20;
}
.back-btn.data-v-0b50ab4e {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
}
.back-arrow.data-v-0b50ab4e {
  color: #fff;
  font-size: 34rpx;
  line-height: 1;
}
.back-text.data-v-0b50ab4e {
  color: #fff;
  font-size: 28rpx;
}

/* 分享按钮样式 */
.share-btn.data-v-0b50ab4e {
  margin-left: auto;
  padding: 0rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 28rpx;
  margin: 0 0 0 10rpx;
}
.video-container.data-v-0b50ab4e {
  width: 100%;
  height: 100vh;
  background: #000;
  position: relative;
}
.video-player.data-v-0b50ab4e {
  width: 100%;
  height: 100%;
}

/* 屏蔽 H5 下原生视频控件的时间线与时间显示（Chrome/Safari/webkit 系） */
.video-player.data-v-0b50ab4e::-webkit-media-controls-timeline {
  display: none !important;
}
.video-player.data-v-0b50ab4e::-webkit-media-controls-current-time-display,
.video-player.data-v-0b50ab4e::-webkit-media-controls-time-remaining-display {
  display: none !important;
}
.video-player.data-v-0b50ab4e::-webkit-media-controls-play-button {
  display: none !important;
}
.video-player.data-v-0b50ab4e::-webkit-media-controls-start-playback-button {
  display: none !important;
}
.video-player.data-v-0b50ab4e::-webkit-media-controls {
  overflow: hidden !important;
}

/* 暂停时的居中播放覆盖层 */
.center-play-overlay.data-v-0b50ab4e {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.28);
  z-index: 30;
}
.play-icon.data-v-0b50ab4e {
  width: 120rpx;
  height: 120rpx;
}

/* 倍速控件样式 */
.rate-controls.data-v-0b50ab4e {
  position: absolute;
  bottom: 28rpx;
  right: 24rpx;
  display: flex;
  gap: 12rpx;
  z-index: 25;
}
.rate-chip.data-v-0b50ab4e {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 26rpx;
}
.rate-chip.active.data-v-0b50ab4e {
  background: rgba(255, 255, 255, 0.36);
}

/* 下拉倍速控件样式 */
.rate-dropdown.data-v-0b50ab4e {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 26rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}
.rate-selected.data-v-0b50ab4e {
  color: #fff;
}
.dropdown-icon.data-v-0b50ab4e {
  font-size: 22rpx;
  opacity: 0.8;
}
.custom-controls.data-v-0b50ab4e {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.3s ease;
  z-index: 25;
}
.custom-controls.horizontal-layout.data-v-0b50ab4e {
  flex-direction: column;
  right: 0;
  left: auto;
  width: 120rpx;
  height: 100%;
  justify-content: center;
  background: linear-gradient(to left, transparent, rgba(0, 0, 0, 0.7));
}
.control-btn.data-v-0b50ab4e {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
}
.control-icon.data-v-0b50ab4e {
  width: 40rpx;
  height: 40rpx;
}
.progress-container.data-v-0b50ab4e {
  flex: 1;
  margin: 0 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.progress-slider.data-v-0b50ab4e {
  width: 100%;
}
.time-text.data-v-0b50ab4e {
  color: #fff;
  font-size: 24rpx;
  margin-top: 10rpx;
}

/* 拖拽进度预览覆盖层 */
.seek-overlay.data-v-0b50ab4e {
  position: absolute;
  bottom: 120rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  z-index: 28;
}
.seek-info.data-v-0b50ab4e {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(6px);
}
.seek-time.data-v-0b50ab4e {
  color: #fff;
  font-size: 28rpx;
}
.seek-progress-bar.data-v-0b50ab4e {
  width: 80%;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  overflow: hidden;
}
.seek-progress.data-v-0b50ab4e {
  height: 100%;
  background: #ff4d4f;
}

/* 下拉提示 */
.drag-hint.data-v-0b50ab4e {
  position: absolute;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 30;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(6px);
  pointer-events: none;
}
.drag-hint-text.data-v-0b50ab4e {
  color: #fff;
  font-size: 26rpx;
}

/* 横屏适配 */
@media (orientation: landscape) {
.custom-controls.data-v-0b50ab4e {
    flex-direction: column;
    right: 0;
    left: auto;
    width: 120rpx;
    height: 100%;
    justify-content: center;
}
}
