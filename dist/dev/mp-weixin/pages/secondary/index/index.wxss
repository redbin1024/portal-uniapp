
.page.data-v-0b50ab4e {
  width: 100%;
  height: 100vh;
  position: relative;
  background: #000;
  will-change: transform;
}
.nav-bar.data-v-0b50ab4e {
  position: absolute;
  top: 100rpx;
  left: 0;
  right: 0;
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0));
  z-index: 20;
}
.back-btn.data-v-0b50ab4e {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
}
.back-arrow.data-v-0b50ab4e {
  color: #fff;
  font-size: 34rpx;
  line-height: 1;
}
.back-text.data-v-0b50ab4e {
  color: #fff;
  font-size: 28rpx;
}

/* 分享按钮样式 */
.share-btn.data-v-0b50ab4e {
  margin-left: auto;
  padding: 0rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 28rpx;
  margin: 0 0 0 10rpx;
}
.video-container.data-v-0b50ab4e {
  width: 100%;
  height: 100vh;
  background: #000;
  position: relative;
}
.video-player.data-v-0b50ab4e {
  width: 100%;
  height: 100%;
}
.custom-controls.data-v-0b50ab4e {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.3s ease;
}
.custom-controls.horizontal-layout.data-v-0b50ab4e {
  flex-direction: column;
  right: 0;
  left: auto;
  width: 120rpx;
  height: 100%;
  justify-content: center;
  background: linear-gradient(to left, transparent, rgba(0, 0, 0, 0.7));
}
.control-btn.data-v-0b50ab4e {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
}
.control-icon.data-v-0b50ab4e {
  width: 40rpx;
  height: 40rpx;
}
.progress-container.data-v-0b50ab4e {
  flex: 1;
  margin: 0 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.progress-slider.data-v-0b50ab4e {
  width: 100%;
}
.time-text.data-v-0b50ab4e {
  color: #fff;
  font-size: 24rpx;
  margin-top: 10rpx;
}

/* 下拉提示 */
.drag-hint.data-v-0b50ab4e {
  position: absolute;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 30;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(6px);
  pointer-events: none;
}
.drag-hint-text.data-v-0b50ab4e {
  color: #fff;
  font-size: 26rpx;
}

/* 横屏适配 */
@media (orientation: landscape) {
.custom-controls.data-v-0b50ab4e {
    flex-direction: column;
    right: 0;
    left: auto;
    width: 120rpx;
    height: 100%;
    justify-content: center;
}
}
