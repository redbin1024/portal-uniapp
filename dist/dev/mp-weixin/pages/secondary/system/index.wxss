
.main.data-v-8bd1f02a {
  background-color: #ffffff;
  min-height: 100vh;
}
.first.data-v-8bd1f02a {
  padding-top: 40rpx;
  background: #fff;
}
.head.data-v-8bd1f02a {
  background: #f0f0f0;
  margin-top: 80rpx;
}
.headTab.data-v-8bd1f02a {
  display: flex;
  justify-content: space-around;
  align-items: center;
  /* padding: 20rpx; */
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.tab-item.data-v-8bd1f02a {
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 20rpx 0;
}
.tab-text.data-v-8bd1f02a {
  font-size: 36rpx;
  color: #000000;
  transition: color 0.3s ease;
}
.tab-item.active .tab-text.data-v-8bd1f02a {
  color: #000000;
  font-weight: bold;
}
.tab-line.data-v-8bd1f02a {
  width: 60rpx;
  height: 6rpx;
  background: #000000;
  border-radius: 2rpx;
  margin-top: 10rpx;
  animation: lineSlide-8bd1f02a 0.3s ease;
}
@keyframes lineSlide-8bd1f02a {
from {
    width: 0;
}
to {
    width: 60rpx;
}
}
.slideshow.data-v-8bd1f02a {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 0;
  border-radius: 0 0 40rpx 40rpx;
}
.content-img.data-v-8bd1f02a {
  margin-top: 38rpx;
  width: 750rpx;
}
.content-img image.data-v-8bd1f02a {
  width: 100%;
}
.winthecustomer-content.data-v-8bd1f02a {
  display: flex;
  flex-wrap: wrap;
  padding: 0rpx 18rpx 52rpx 18rpx;
  background: linear-gradient(to bottom, #ffffff 0%, #3351e2 70%);
  padding-top: 20rpx;
}
.winthecustomer-content1.data-v-8bd1f02a:nth-of-type(2n) {
  margin-left: 3%;
}
.winthecustomer-content1.data-v-8bd1f02a {
  width: 48%;
  background: #f2f6ff;
  margin-bottom: 38rpx;
  border-radius: 20rpx;
}
.winthecustomer-content1 image.data-v-8bd1f02a {
  width: 100%;
  height: 350rpx;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
}
.winthecustomer-content2.data-v-8bd1f02a {
  width: 100%;
  padding: 20rpx 0;
  text-align: center;
  border-bottom-left-radius: 20rpx;
  border-bottom-right-radius: 20rpx;
  display: flex;
  justify-content: space-between;
}
.winthecustomer-content2-1.data-v-8bd1f02a {
  color: #000000;
  font-size: 28rpx;
  margin-left: 24rpx;
}
.winthecustomer-content2-2.data-v-8bd1f02a {
  width: 112rpx;
  height: 44rpx;
  background: #3552e3;
  border-radius: 100rpx;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 44rpx;
  text-align: center;
  margin-right: 24rpx;
}
.loading-placeholder.data-v-8bd1f02a {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 800rpx;
  background: #f8f8f8;
  border-radius: 20rpx;
  margin: 20rpx;
}
.loading-placeholder text.data-v-8bd1f02a {
  color: #999;
  font-size: 28rpx;
}
.video.data-v-8bd1f02a {
  width: 702rpx;
  height: 394rpx;
  border-radius: 20rpx;
  margin: 20rpx auto;
  position: relative;
}
.video video.data-v-8bd1f02a {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}
.videoTitle.data-v-8bd1f02a {
  margin-top: 20rpx;
}
.videoTitle1.data-v-8bd1f02a {
  color: #000000;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-top: 24rpx;
}
.videoTitle2.data-v-8bd1f02a {
  color: #4e4d4d;
  font-size: 24rpx;
  padding: 0 24rpx;
}
/* 自定义播放按钮样式 */
.custom-play-button.data-v-8bd1f02a {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  opacity: 0.5;
}
.custom-play-button.data-v-8bd1f02a:hover {
  transform: translate(-50%, -50%) scale(1.1);
  /* background: rgba(255, 255, 255, 1); */
}
.custom-play-button .play-icon.data-v-8bd1f02a {
  width: 80rpx;
  height: 80rpx;
}
