
view.data-v-fc420d75,
image.data-v-fc420d75,
text.data-v-fc420d75 {
  box-sizing: border-box;
}
.main.data-v-fc420d75 {
  background: #ffffff;
  width: 100%;
  max-width: 100vw;
  height: 100vh;
  /* scroll-view 需要固定高度才能滚动 */
  padding-top: 40rpx;
}

/**最近动态 */
.dynamic.data-v-fc420d75 {
  background: #ffffff;
  padding: 60rpx 28rpx;
  margin: 40rpx 0;
}
.dynamic-title.data-v-fc420d75 {
  font-size: 40rpx;
  font-weight: bold;
  color: #000000;
  text-align: center;
}
.dynamic-title1.data-v-fc420d75 {
  font-size: 26rpx;
  color: #3d3d3d;
  margin-top: 12rpx;
  text-align: center;
  margin-bottom: 60rpx;
}

/* 动态内容样式 */
.dynamic-content.data-v-fc420d75 {
  margin-top: 40rpx;
}
.dynamic-item.data-v-fc420d75 {
  display: flex;
  align-items: flex-start;
  margin-bottom: 90rpx;
  position: relative;
  min-height: auto;
  width: 100%;
  /* 移除 overflow: hidden，避免影响滚动 */
  box-sizing: border-box;
  cursor: pointer;
  transition: all 0.3s ease;
}
.dynamic-item.data-v-fc420d75:hover {
  transform: translateY(-2rpx);
}
.dynamic-item.data-v-fc420d75:active {
  transform: translateY(0);
  opacity: 0.8;
}
.dynamic-left.data-v-fc420d75 {
  width: 45%;
  flex-shrink: 0;
  box-sizing: border-box;
  /* 初始状态：从左侧淡入 */
  transform: translateX(-80rpx);
  opacity: 0;
  transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

/* 左侧内容淡入动画 */
.dynamic-left.animate-fade-in-left.data-v-fc420d75 {
  transform: translateX(0);
  opacity: 1;
}
.dynamic-date.data-v-fc420d75 {
  font-size: 24rpx;
  color: #2c80ff;
  margin-bottom: 8rpx;
  font-weight: bold;
  transform: translateY(20rpx);
  opacity: 0;
  transition: all 0.6s ease-out 0.3s;
}
.dynamic-text1.data-v-fc420d75 {
  color: #3d3d3d;
  font-size: 28rpx;
  font-weight: bold;
  transform: translateY(20rpx);
  opacity: 0;
  transition: all 0.6s ease-out 0.4s;
}
.dynamic-text.data-v-fc420d75 {
  font-size: 24rpx;
  color: #535353;
  line-height: 1.5;
  transform: translateY(20rpx);
  opacity: 0;
  transition: all 0.6s ease-out 0.5s;
}

/* 左侧内容子元素动画 */
.dynamic-left.animate-fade-in-left .dynamic-date.data-v-fc420d75,
.dynamic-left.animate-fade-in-left .dynamic-text1.data-v-fc420d75,
.dynamic-left.animate-fade-in-left .dynamic-text.data-v-fc420d75 {
  transform: translateY(0);
  opacity: 1;
}
.dynamic-center.data-v-fc420d75 {
  display: flex;
  flex-direction: column;
  align-items: center;
  /* margin: 0 20rpx; */
  position: relative;
  flex: 0 0 auto;
  width: 15%;
}
.step-dot.data-v-fc420d75 {
  width: 20rpx;
  height: 20rpx;
  border-radius: 45%;
  background-color: #007aff;
  border: 3rpx solid #ffffff;
  box-shadow: 0 0 0 2rpx #007aff;
  z-index: 2;
  position: relative;
  transform: scale(0.5);
  opacity: 0.5;
  transition: all 0.6s ease-out 0.4s; /* 延迟0.4s，让中间点动画在左右内容之后出现 */
}

/* 中间点动画 */
.step-dot.animate-dot.data-v-fc420d75 {
  transform: scale(1);
  opacity: 1;
  box-shadow: 0 0 0 3rpx #007aff, 0 0 10rpx rgba(0, 122, 255, 0.5);
}
.step-dot.active.data-v-fc420d75 {
  background-color: #007aff;
  box-shadow: 0 0 0 2rpx #007aff;
}
.step-line.data-v-fc420d75 {
  width: 2rpx;
  background-color: #e0e0e0;
  position: absolute;
  top: 30rpx;
  left: 50%;
  height: 290rpx;
  z-index: 1;
}
.dynamic-right.data-v-fc420d75 {
  width: 40%;
  flex-shrink: 0;
  box-sizing: border-box;
  overflow: hidden;
  /* 初始状态：从右侧淡入 */
  transform: translateX(80rpx);
  opacity: 0;
  transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.2s; /* 延迟0.2s，让左右动画错开 */
}

/* 右侧内容淡入动画 */
.dynamic-right.animate-fade-in-right.data-v-fc420d75 {
  transform: translateX(0);
  opacity: 1;
}
.dynamic-image.data-v-fc420d75 {
  width: 100%;
  max-width: 280rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  transform: scale(0.8) rotate(5deg);
  opacity: 0;
  transition: all 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) 0.3s;
  box-sizing: border-box;
}

/* 右侧图片动画 */
.dynamic-right.animate-fade-in-right .dynamic-image.data-v-fc420d75 {
  transform: scale(1) rotate(0deg);
  opacity: 1;
}

/**成功案例 */
.container.data-v-fc420d75 {
  padding: 60rpx 26rpx 20rpx 26rpx;
  background-color: #fff;
}
.container-title.data-v-fc420d75 {
  font-size: 40rpx;
  font-weight: bold;
  color: #000000;
  margin-bottom: 80rpx;
  text-align: center;
}
.list-item.data-v-fc420d75 {
  display: flex;
  align-items: flex-start;
  border-radius: 16rpx;
  height: 270rpx;
  padding: 0 24rpx;
  margin-bottom: 62rpx;
  position: relative;
  width: 100%;
  box-sizing: border-box;
  /* 初始状态 - 与winthecustomer-content1相同的动画效果 */
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.6s ease-out;
}
.list-item.list-item-animate.data-v-fc420d75 {
  opacity: 1;
  transform: translateY(0);
}
.image-container.data-v-fc420d75 {
  flex-shrink: 0;
  margin-right: 24rpx;
  position: relative;
}
.item-image.data-v-fc420d75 {
  width: 214rpx;
  height: 282rpx;
  border-radius: 20rpx;
  background-color: #f0f0f0;
  border: 3rpx solid #ffffff;
  position: relative;
  top: -30rpx;
}
.content-container.data-v-fc420d75 {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}
.title.data-v-fc420d75 {
  height: 80rpx;
  line-height: 90rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #000000;
  margin-bottom: 12rpx;
}
.description.data-v-fc420d75 {
  font-size: 24rpx;
  color: #7e7f80;
  line-height: 1.5;
  word-break: break-all;
}
/**轮播图样式 */
.slideshow.data-v-fc420d75 {
  width: 100%;
  height: 800rpx;
  position: relative;
  overflow: hidden;
}
.slideshow-item.data-v-fc420d75 {
  width: 100%;
  height: 100%;
  position: relative;
}
.slideshow-image.data-v-fc420d75 {
  width: 100%;
  height: 100%;
}
.slideshow-overlay.data-v-fc420d75 {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 20rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  color: white;
}
.slideshow-title.data-v-fc420d75 {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}
.slideshow-desc.data-v-fc420d75 {
  font-size: 24rpx;
}
/* 查看更多按钮样式 */
.view-more-btn.data-v-fc420d75 {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 40rpx 26rpx 0;
  padding: 20rpx 0;
  cursor: pointer;
  opacity: 0;
  transform: translateY(20rpx);
  transition: all 0.6s ease-out;
}

/* 当按钮显示时的动画效果 */
.view-more-btn.view-more-animate.data-v-fc420d75 {
  opacity: 1;
  transform: translateY(0);
}
.view-more-btn.data-v-fc420d75:active {
  opacity: 0.7;
}
.view-more-text.data-v-fc420d75 {
  font-size: 28rpx;
  color: #2c80ff;
  margin-right: 10rpx;
}
.arrow-right.data-v-fc420d75 {
  font-size: 28rpx;
  color: #2c80ff;
  font-weight: bold;
}
