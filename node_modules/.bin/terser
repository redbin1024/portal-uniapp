#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/redbin/Documents/槿墨工作区/官网小程序/mastergo-project/node_modules/.pnpm/terser@5.44.0/node_modules/terser/node_modules:/Users/redbin/Documents/槿墨工作区/官网小程序/mastergo-project/node_modules/.pnpm/terser@5.44.0/node_modules:/Users/redbin/Documents/槿墨工作区/官网小程序/mastergo-project/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/redbin/Documents/槿墨工作区/官网小程序/mastergo-project/node_modules/.pnpm/terser@5.44.0/node_modules/terser/node_modules:/Users/redbin/Documents/槿墨工作区/官网小程序/mastergo-project/node_modules/.pnpm/terser@5.44.0/node_modules:/Users/redbin/Documents/槿墨工作区/官网小程序/mastergo-project/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../terser/bin/terser" "$@"
else
  exec node  "$basedir/../terser/bin/terser" "$@"
fi
